/* =========================================================
   Global
   ========================================================= */

QWidget {
    background-color: #313338;
    color: #dbdee1;
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow {
    background-color: #313338;
}

/* =========================================================
   Chat Header
   ========================================================= */

#chatHeader {
    background-color: #2b2d31;
    border-bottom: 1px solid #1e1f22;
}

#chatAvatar {
    background-color: #5865f2;
    color: white;
    border-radius: 17px;
    font-size: 13px;
    font-weight: bold;
}

#chatUsername {
    color: #f2f3f5;
    font-size: 15px;
    font-weight: 600;
}

#chatStatus {
    color: #949ba4;
    font-size: 12px;
}

/* =========================================================
   Chat Messages
   ========================================================= */

#chatScroll {
    background-color: #313338;
    border: none;
}

#messageContainer {
    background-color: #313338;
}

#chatEmpty {
    color: #80848e;
    font-size: 14px;
}

#incomingMessage {
    background-color: #2b2d31;
    border-radius: 8px;
    border: none;
}

#outgoingMessage {
    background-color: #5865f2;
    border-radius: 8px;
    border: none;
}

#messageSender {
    color: #b5bac1;
    font-size: 12px;
    font-weight: 600;
}

#messageText {
    color: #f2f3f5;
    font-size: 14px;
}

#messageTimestamp {
    color: #949ba4;
    font-size: 10px;
}

/* =========================================================
   Chat Input
   ========================================================= */

#chatInputFrame {
    background-color: #2b2d31;
    border-top: 1px solid #1e1f22;
}

#messageInput {
    background-color: #383a40;
    color: #dbdee1;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #5865f2;
}

#messageInput:focus {
    background-color: #404249;
}

#messageInput:disabled {
    color: #72767d;
}

#attachmentBtn {
    background-color: transparent;
    color: #b5bac1;
    border: none;
    border-radius: 17px;
    font-size: 20px;
    font-weight: bold;
}

#attachmentBtn:hover {
    background-color: #404249;
    color: #f2f3f5;
}

#attachmentBtn:pressed {
    background-color: #4e5058;
}

#attachmentBtn:disabled {
    color: #4e5058;
}

#sendBtn {
    background-color: #5865f2;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 0 16px;
    font-weight: 600;
}

#sendBtn:hover {
    background-color: #4752c4;
}

#sendBtn:pressed {
    background-color: #3c45a5;
}

#sendBtn:disabled {
    background-color: #3f4147;
    color: #72767d;
}

/* =========================================================
   Friend View
   ========================================================= */

#friendList {
    background-color: #2b2d31;
    border: none;
    outline: none;
    padding: 4px 6px;
}

#friendList::item {
    background-color: transparent;
    color: #b5bac1;
    border-radius: 6px;
    padding: 10px 12px;
    margin: 2px 0;
}

#friendList::item:hover {
    background-color: #35373c;
    color: #dbdee1;
}

#friendList::item:selected {
    background-color: #404249;
    color: #ffffff;
}

#friendSearch {
    background-color: #1e1f22;
    color: #dbdee1;
    border: none;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #5865f2;
}

#friendSearch:focus {
    background-color: #111214;
}

#searchIcon {
    color: #949ba4;
}

/* =========================================================
   Friends Header
   ========================================================= */

#sectionLabel {
    color: #949ba4;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#addFriendBtn {
    background-color: #5865f2;
    color: white;
    border: none;
    border-radius: 15px;
    font-size: 20px;
    font-weight: 500;
}

#addFriendBtn:hover {
    background-color: #4752c4;
}

#addFriendBtn:pressed {
    background-color: #3c45a5;
}

/* =========================================================
   Scrollbars
   ========================================================= */

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
}

QScrollBar::handle:vertical {
    background-color: #1e1f22;
    min-height: 40px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #18191c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* =========================================================
   Buttons
   ========================================================= */

QPushButton {
    outline: none;
}

/* =========================================================
   Login View
   ========================================================= */

#title {
    color: #f2f3f5;
    font-size: 28px;
    font-weight: 700;
}

QLabel {
    color: #b5bac1;
}

QLineEdit {
    background-color: #1e1f22;
    color: #dbdee1;
    border: 1px solid #1e1f22;
    border-radius: 6px;
    padding: 10px 12px;
    selection-background-color: #5865f2;
}

QLineEdit:focus {
    background-color: #111214;
    border: 1px solid #5865f2;
}

QLineEdit:disabled {
    color: #72767d;
    background-color: #2b2d31;
}

QPushButton {
    outline: none;
    background-color: #5865f2;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #4752c4;
}

QPushButton:pressed {
    background-color: #3c45a5;
}

QPushButton:disabled {
    background-color: #3f4147;
    color: #72767d;
}