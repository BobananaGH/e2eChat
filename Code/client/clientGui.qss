/* ============================================================
   E2EEChat — Modern 2026 Dark UI
   ============================================================ */

/* ============================================================
   ROOT
   ============================================================ */

QMainWindow,
QWidget#centralWidget {
    background: #0f1117;
    color: #e6e9ef;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
}


/* ============================================================
   LEFT SIDEBAR
   ============================================================ */

QWidget#sidebar {
    background: #151821;
    border-right: 1px solid #252936;
}

QWidget#appHeader {
    background: #151821;
}

QLabel#appTitle {
    color: #f5f7fb;
    font-size: 21px;
    font-weight: 700;
}


/* ============================================================
   SEARCH
   ============================================================ */

QLineEdit#searchInput {
    background: #20242e;
    border: 1px solid #2b303c;
    border-radius: 8px;
    padding: 9px 12px;
    color: #e8ebf1;
    selection-background-color: #5865f2;
}

QLineEdit#searchInput:focus {
    border: 1px solid #5865f2;
}

QLineEdit#searchInput::placeholder {
    color: #777d8c;
}


/* ============================================================
   SIDEBAR SECTION
   ============================================================ */

QLabel#sectionLabel {
    color: #777e8e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}


/* ============================================================
   CHAT LIST
   ============================================================ */

QListWidget#chatList {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 8px;
}

QListWidget#chatList::item {
    background: transparent;
    border-radius: 8px;
    padding: 0px;
    margin: 1px 0px;
}

QListWidget#chatList::item:hover {
    background: #20242e;
}

QListWidget#chatList::item:selected {
    background: #2a2f3b;
}

QLabel#chatListName {
    color: #e7eaf0;
    font-size: 14px;
    font-weight: 600;
}

QLabel#chatListStatus {
    color: #7e8493;
    font-size: 12px;
}

QLabel#userStatus {
    color: #43d17a;
    font-size: 11px;
}


/* ============================================================
   ACCOUNT PANEL
   ============================================================ */

QWidget#accountPanel {
    background: #11141b;
    border-top: 1px solid #252936;
}

QLabel#accountStatus {
    color: #43d17a;
    font-size: 11px;
}

QLabel#accountName {
    color: #f0f2f6;
    font-size: 13px;
    font-weight: 600;
}

QLabel#accountState {
    color: #777e8e;
    font-size: 11px;
}

QPushButton#settingsButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #8b91a0;
    font-size: 18px;
}

QPushButton#settingsButton:hover {
    background: #252a35;
    color: #ffffff;
}

QPushButton#settingsButton:pressed {
    background: #303644;
}


/* ============================================================
   RIGHT CHAT AREA
   ============================================================ */

QWidget#chatArea {
    background: #0f1117;
}


/* ============================================================
   CHAT HEADER
   ============================================================ */

QWidget#chatHeader {
    background: #13161d;
    border-bottom: 1px solid #252936;
}

QLabel#chatAvatar {
    color: #43d17a;
    font-size: 15px;
}

QLabel#chatUsername {
    color: #f3f5f8;
    font-size: 15px;
    font-weight: 700;
}

QLabel#chatStatus {
    color: #777e8e;
    font-size: 11px;
}

QLabel#e2eeIndicator {
    color: #43d17a;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#chatMenuButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #858b9a;
    font-size: 22px;
}

QPushButton#chatMenuButton:hover {
    background: #242934;
    color: #ffffff;
}

QPushButton#chatMenuButton:pressed {
    background: #303644;
}


/* ============================================================
   MESSAGE AREA
   ============================================================ */

QScrollArea#messageScroll {
    background: #0f1117;
    border: none;
}

QWidget#messageContainer {
    background: #0f1117;
}


/* ============================================================
   MESSAGE BUBBLES
   ============================================================ */

QFrame#incomingMessage {
    background: #20242e;
    border: 1px solid #292e39;
    border-radius: 12px;
}

QFrame#outgoingMessage {
    background: #5865f2;
    border: 1px solid #5865f2;
    border-radius: 12px;
}

QLabel#messageSender {
    color: #8f96a6;
    font-size: 11px;
    font-weight: 600;
}

QFrame#outgoingMessage QLabel#messageSender {
    color: #dfe2ff;
}

QLabel#messageText {
    color: #e9ecf2;
    font-size: 14px;
}

QFrame#outgoingMessage QLabel#messageText {
    color: #ffffff;
}


/* ============================================================
   MESSAGE INPUT
   ============================================================ */

QWidget#inputContainer {
    background: #13161d;
    border-top: 1px solid #252936;
}

QLineEdit#messageInput {
    background: #20242e;
    border: 1px solid #2b303c;
    border-radius: 10px;
    padding: 10px 13px;
    color: #f0f2f6;
    selection-background-color: #5865f2;
}

QLineEdit#messageInput:focus {
    border: 1px solid #5865f2;
}

QLineEdit#messageInput::placeholder {
    color: #777e8e;
}


/* ============================================================
   ATTACH BUTTON
   ============================================================ */

QPushButton#attachButton {
    background: #20242e;
    border: 1px solid #2b303c;
    border-radius: 10px;
    color: #aeb4c1;
    font-size: 22px;
    font-weight: 400;
}

QPushButton#attachButton:hover {
    background: #292e39;
    color: #ffffff;
}

QPushButton#attachButton:pressed {
    background: #343a48;
}


/* ============================================================
   SEND BUTTON
   ============================================================ */

QPushButton#sendButton {
    background: #5865f2;
    border: none;
    border-radius: 10px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}

QPushButton#sendButton:hover {
    background: #6975f5;
}

QPushButton#sendButton:pressed {
    background: #4752c4;
}

QPushButton#sendButton:disabled {
    background: #292e39;
    color: #5f6572;
}


/* ============================================================
   SCROLLBAR
   ============================================================ */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #303542;
    min-height: 40px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #414756;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


/* ============================================================
   HORIZONTAL SCROLLBAR
   ============================================================ */

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #303542;
    min-width: 40px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}